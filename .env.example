# ---- Core ----
ENV=dev
JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# ---- Database backend: "sqlite" (local/free) or "firestore" (cloud) ----
DB_BACKEND=sqlite
SQLITE_PATH=data/diet_planner.db

# ---- Storage backend: "local" (free) or "firebase" (cloud) ----
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=data/storage
MAX_UPLOAD_BYTES=2097152

# ---- Firebase (only needed if DB_BACKEND=firestore or STORAGE_BACKEND=firebase) ----
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=

# ---- Optional AI API (Version B). Leave AI_PROVIDER=none to always use the free rule-based engine ----
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# DB_BACKEND=supabase / STORAGE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=user-files